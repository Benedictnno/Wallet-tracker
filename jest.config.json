{
  "preset": "ts-jest",
  "testEnvironment": "node",
  "moduleNameMapper": {
    "^@/(.*)$": "<rootDir>/$1"
  },
  "testMatch": ["**/__tests__/**/*.test.ts"],
  "transform": {
    "^.+\\.tsx?$": ["ts-jest", {
      "tsconfig": {
        "module": "commonjs"
      }
    }]
  },
  "transformIgnorePatterns": [
    "/node_modules/(?!(rpc-websockets|@solana|superstruct|@noble|jayson)/)"
  ]
}
